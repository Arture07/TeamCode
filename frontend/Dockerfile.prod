# Production Dockerfile — Ultraleve e instantâneo
# O build dos arquivos estáticos é feito previamente no CI (GitHub Actions)
FROM nginx:1.27.0-alpine

# Copia certificados SSL de fallback para /tmp/ssl
COPY ssl/ /tmp/ssl/

# Copia o build estático do Vite diretamente para a pasta pública do Nginx
COPY dist /usr/share/nginx/html

# Sobrescreve a configuração padrão do Nginx
COPY nginx.conf /etc/nginx/nginx.conf

# Script de inicialização que detecta certificados reais vs fallback
COPY entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

EXPOSE 80 443
ENTRYPOINT ["/entrypoint.sh"]
