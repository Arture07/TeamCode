POSTGRES_DB=teamcode_db
POSTGRES_USER=teamcode_user
POSTGRES_PASSWORD=TROCAR_POR_UMA_SENHA_FORTE_AQUI

# Autenticação JWT
# Gere um segredo forte: openssl rand -base64 64
JWT_SECRET=TROCAR_POR_UM_SEGREDO_BASE64_DE_64_BYTES

# Conta Super Admin Inicial (Opcional - padrão: admin / admin123)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=TROCAR_POR_SENHA_SUPER_ADMIN_FORTE

# Inteligência Artificial (Session Service)
# Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY=SUA_CHAVE_GEMINI_AQUI
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-flash-lite-latest,gemini-2.5-flash,gemini-2.0-flash

# OAuth — GitHub (crie em https://github.com/settings/developers)
GITHUB_CLIENT_ID=SEU_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=SEU_GITHUB_CLIENT_SECRET

# OAuth — Google (crie em https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=SEU_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=SEU_GOOGLE_CLIENT_SECRET

# Redis (usado internamente pelo Docker)
REDIS_PASSWORD=TROCAR_POR_UMA_SENHA_FORTE_REDIS

# CORS (Padrões de origens permitidas separados por vírgula. Padrão: *)
CORS_ALLOWED_ORIGIN_PATTERNS=*
